{
  "name": "@mogura/moguchart-react",
  "type": "module",
  "version": "1.2.0",
  "description": "React wrapper for @mogura/moguchart-core Gantt chart component",
  "license": "MIT",
  "author": "Murakami Hiroyuki",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiro-murakami/moguchart-core.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/hiro-murakami/moguchart-core",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gantt",
    "gantt-chart",
    "moguchart",
    "react",
    "react-gantt",
    "web-components"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.ja.md"
  ],
  "main": "./dist/moguchart-react.umd.js",
  "module": "./dist/moguchart-react.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/moguchart-react.mjs",
      "require": "./dist/moguchart-react.umd.js"
    }
  },
  "scripts": {
    "build": "vite build && pnpm exec tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@mogura/moguchart-core": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@lit/react": "^1.0.8"
  },
  "devDependencies": {
    "@mogura/moguchart-core": "workspace:*",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
