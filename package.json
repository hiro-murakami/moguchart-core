{
  "name": "@mogura/moguchart",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "main": "./dist/moguchart.umd.js",
  "module": "./dist/moguchart.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/moguchart.mjs",
      "require": "./dist/moguchart.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm exec tsc",
    "build:demo": "BUILD_MODE=demo vite build && pnpm exec tsc",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "refresh:packages": "rm -rf node_modules pnpm-lock.yaml && pnpm i"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.12.0",
    "jsdom": "^27.4.0",
    "lit": "^3.3.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1",
    "dayjs": "^1.11.19",
    "lodash": "^4.17.21"
  }
}
