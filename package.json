{
  "name": "moguchart-monorepo",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @mogura/moguchart-core dev",
    "sync:docs": "cp README.md README.ja.md CHANGELOG.md CHANGELOG.ja.md LICENSE packages/core/ && cp LICENSE packages/plugin-export/ && cp LICENSE packages/react/ && cp LICENSE packages/vue/",
    "build": "pnpm sync:docs && pnpm build:core && pnpm build:export && pnpm build:react && pnpm build:vue",
    "build:core": "pnpm --filter @mogura/moguchart-core build",
    "build:export": "pnpm --filter @mogura/moguchart-plugin-export build",
    "build:react": "pnpm --filter @mogura/moguchart-react build",
    "build:vue": "pnpm --filter @mogura/moguchart-vue build",
    "build:demo": "pnpm --filter @mogura/moguchart-core build:demo",
    "preview": "pnpm --filter @mogura/moguchart-core preview",
    "test": "pnpm -r run test",
    "test:run": "pnpm -r run test:run",
    "test:core": "pnpm --filter @mogura/moguchart-core test:run",
    "test:export": "pnpm --filter @mogura/moguchart-plugin-export test:run",
    "test:react": "pnpm --filter @mogura/moguchart-react test:run",
    "test:vue": "pnpm --filter @mogura/moguchart-vue test:run",
    "refresh:packages": "rm -rf node_modules pnpm-lock.yaml packages/*/node_modules && pnpm i"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}